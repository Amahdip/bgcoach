# Copy to .env (run.sh loads it). Everything here is optional.

# Claude API key for the Persian "Why" explanations. Without it, the explanation
# is built from the same facts with fixed templates.
# ANTHROPIC_API_KEY=sk-ant-...

# Port for run.sh (default 8765)
# PORT=8765

# Database location (default data/bgcoach.sqlite)
# BGCOACH_DB=/path/to/bgcoach.sqlite
